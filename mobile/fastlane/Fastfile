SCHEME = "TechRPMobile"

# ─── iOS ────────────────────────────────────────────────────────────────────

platform :ios do
  desc "Run iOS tests"
  lane :test do
    scan(scheme: SCHEME, workspace: "ios/TechRPMobile.xcworkspace")
  end

  desc "Build + upload to TestFlight (internal)"
  lane :beta do |options|
    increment_build_number(xcodeproj: "ios/TechRPMobile.xcodeproj") unless options[:skip_build_increment]
    match(type: "appstore", readonly: true)
    gym(
      scheme: SCHEME,
      workspace: "ios/TechRPMobile.xcworkspace",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.techrp.mobile" => "match AppStore com.techrp.mobile"
        }
      }
    )
    pilot(skip_waiting_for_build_processing: true)
  end

  desc "Submit latest TestFlight build for App Store review"
  lane :release do
    deliver(
      build_number: latest_testflight_build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false
    )
  end
end

# ─── Android ────────────────────────────────────────────────────────────────

platform :android do
  desc "Build release AAB"
  lane :build do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
  end

  desc "Upload to Play Store internal track"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true
    )
  end

  desc "Promote internal build to production"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_changelogs: true
    )
  end
end
