SCHEME = "TechRPMobile"

# ─── iOS ────────────────────────────────────────────────────────────────────

platform :ios do
  desc "Run iOS tests"
  lane :test do
    scan(scheme: SCHEME, workspace: "ios/TechRPMobile.xcworkspace")
  end

  desc "Build + upload to TestFlight (internal)"
  lane :beta do |options|
    # gym on Ruby 4.x crashes its own error handler — build with xcodebuild
    # directly and export manually, then upload with pilot.
    increment_build_number(xcodeproj: "ios/TechRPMobile.xcodeproj") unless options[:skip_build_increment]
    match(type: "appstore", readonly: true)

    archive_path = "/tmp/TechRPMobile_#{Time.now.strftime('%Y%m%d_%H%M%S')}.xcarchive"
    export_path  = "/tmp/TechRPMobile_export_#{Time.now.strftime('%Y%m%d_%H%M%S')}"

    sh("xcodebuild",
      "-workspace", "../ios/TechRPMobile.xcworkspace",
      "-scheme", SCHEME,
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "archive"
    )

    export_plist = Tempfile.new(["ExportOptions", ".plist"])
    export_plist.write(<<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>W4FLZ5587D</string>
        <key>signingStyle</key><string>manual</string>
        <key>signingCertificate</key><string>Apple Distribution</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.techrp.mobile</key><string>match AppStore com.techrp.mobile</string>
        </dict>
        <key>stripSwiftSymbols</key><true/>
        <key>uploadSymbols</key><true/>
      </dict>
      </plist>
    PLIST
    export_plist.close

    sh("xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", export_path,
      "-exportOptionsPlist", export_plist.path
    )
    export_plist.unlink

    ipa = Dir["#{export_path}/*.ipa"].first

    # Use xcrun altool directly — pilot/altool via Fastlane credentials chain
    # fails on this setup; xcrun altool with explicit env vars works reliably.
    apple_id = ENV["FASTLANE_APPLE_ID"] || "tim.f.bauer@gmail.com"
    app_pwd  = ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
    raise "FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD not set" unless app_pwd
    sh("xcrun", "altool",
      "--upload-app",
      "--type", "ios",
      "--file", ipa,
      "--username", apple_id,
      "--password", app_pwd
    )
  end

  desc "Submit latest TestFlight build for App Store review"
  lane :release do
    deliver(
      build_number: latest_testflight_build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false
    )
  end
end

# ─── Android ────────────────────────────────────────────────────────────────

platform :android do
  desc "Build release AAB"
  lane :build do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
  end

  desc "Upload to Play Store internal track"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true
    )
  end

  desc "Promote internal build to production"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_changelogs: true
    )
  end
end
